/dts-v1/;

#include <nordic/nrf5340_cpuapp_qkaa.dtsi>
#include "Sokosti_nRF5340-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Sokosti EMG+IMU board (CPUAPP)";
	compatible = "Nordic,Sokosti-nRF5340-cpuapp";

	chosen {
		zephyr,sram = &sram0_image;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,sram-secure-partition = &sram0_s;
		zephyr,sram-non-secure-partition = &sram0_ns;
		zephyr,console = &uart0;
		zephyr,usb-device = &usbd;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &button0;
		sw1 = &button1;
		adsclk = &ads_clk_pwm;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
			label = "User LED 1 BLUE";
		};

		led1: led_1 {
			gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
			label = "User LED 2 YELLOW";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
			label = "Button 1";
		};

		button1: button_1 {
			gpios = <&gpio1 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
			label = "Button 2";
		};
	};

	control {
		compatible = "gpio-leds";

		reset_imu_main: reset_imu_main {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			label = "Reset IMU Main";
		};

		reset_imu_ext: reset_imu_ext {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
			label = "Reset IMU External";
		};

		reset_ads: reset_ads {
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			label = "Reset ADS1299";
		};

		clk_ads: clk_ads {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "Clock ADS1299";
		};

		global_start: global_start {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
			label = "Global Start Signal";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		ads_clk_pwm: ads_clk_pwm {
			pwms = <&pwm0 0 PWM_NSEC(488) PWM_POLARITY_NORMAL>;
			label = "ADS1299 PWM Clock";
		};
	};
};

/* Enable GPIO controllers */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

/* UART0 configuration is disabled because USB CDC ACM is used for the console */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&timer2 {
	status = "okay";
};

/* SPI0 configuration (microSD card) */
&spi0 {
	status = "disabled";
	cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <25000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* SPI2 configuration (Main IMU - BHI360) */
&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	imu_main: imu_main@0 {
		compatible = "bosch,bhi360";
		reg = <0>;
		spi-max-frequency = <8000000>;

		/* Interrupt pin for data ready */
		int-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
		label = "BHI360 Main IMU";
	};

	cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
};

/* SPI3 configuration (External IMU - BHI360) */
&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	imu_ext: imu_ext@0 {
		compatible = "bosch,bhi360";
		reg = <0>;
		spi-max-frequency = <8000000>;

		/* Interrupt pin for data ready */
		int-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		label = "BHI360 External IMU";
	};

	cs-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
};

/* SPI4 configuration (ADS1299 ADC) */
&spi4 {
	status = "okay";
	pinctrl-0 = <&spi4_default>;
	pinctrl-1 = <&spi4_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;   /* must be on the parent */

	ads1299: ads1299@0 {
		compatible = "vnd,spi-device";        /* generic SPI device */
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(1)>;
		label = "ADS1299 ADC";
	};
};

/* USB device configuration */
&usbd {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};
#include "Sokosti_nRF5340-cpuapp_partitioning.dtsi"
#include "Sokosti_nRF5340-shared_sram.dtsi"
