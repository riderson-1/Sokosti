# ARM Security
CONFIG_ARM_MPU=y
CONFIG_ARM_TRUSTZONE_M=y

# GPIO
CONFIG_GPIO=y
CONFIG_NRFX_GPIOTE=y

# UART/Serial (Primary console)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y

# SPI (for IMU and ADC devices)
CONFIG_SPI=y

# USB Device Stack
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_CDC_ACM=y

# LED Support
CONFIG_LED=y

# Button/Input Support
CONFIG_INPUT=y

# SD/MMC Card Support (optional, uncomment if using SD card)
# CONFIG_DISK=y
# CONFIG_DISK_ACCESS=y
# CONFIG_DISK_ACCESS_SPI_MMC=y